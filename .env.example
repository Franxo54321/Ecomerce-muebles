# =============================================
# VARIABLES DE ENTORNO - UrbanPlast / PlastiMuebles
# Copia este archivo como .env y rellena los valores
# =============================================

# Puerto del servidor (Railway lo asigna automáticamente)
PORT=3000

# MongoDB Atlas (obligatorio en producción)
# Formato: mongodb+srv://usuario:contraseña@cluster.mongodb.net/plastimuebles
MONGODB_URI=mongodb://usuario:contraseña@host:27017/plastimuebles

# JWT Secret - usa una cadena larga y aleatoria
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_seguro

# Límite de payload JSON (para imágenes en base64)
JSON_LIMIT=50mb

# Entorno (production | development)
NODE_ENV=production

# URL pública de la app (Railway la asigna automáticamente)
APP_URL=https://tu-app.up.railway.app

# =============================================
# EMAIL - Para verificación de registro
# =============================================
# Con Gmail: genera una "Contraseña de aplicación" en myaccount.google.com > Seguridad
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tucorreo@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion
EMAIL_FROM=UrbanPlast <tucorreo@gmail.com>

# =============================================
# CLOUDINARY - Para almacenar imágenes (obligatorio en Railway)
# Regístrate gratis en cloudinary.com y obtén las credenciales
# =============================================
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# =============================================
# MERCADOPAGO - Pasarela de pagos
# Obtené el Access Token en mercadopago.com.ar/developers
# =============================================
MP_ACCESS_TOKEN=tu_access_token_de_mercadopago

# =============================================
# ADMIN SEED - Usuario administrador inicial (opcional)
# =============================================
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=contraseña_admin_segura
